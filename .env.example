PORT=3000

# Prisma (source of truth for app connection)
DATABASE_URL=postgresql://wordmemo:wordmemo@localhost:5432/wordmemo?schema=public

# Docker Compose Postgres image (must match DATABASE_URL)
DATABASE_USER=wordmemo
DATABASE_PASSWORD=wordmemo
DATABASE_NAME=wordmemo
DATABASE_PORT=5432

# JWT — use long random secrets in production (different for access/refresh)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
