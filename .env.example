# development - local
# staging - digital ocean
ENVIRONMENT=development

# Application port
PORT=3000

# Prisma (source of truth for app connection)
DATABASE_URL=postgresql://wordmemo:wordmemo@localhost:5432/wordmemo?schema=public

# Base64 encoded CA certificate
#   macOS: base64 -i ca-certificate.crt | tr -d '\n'
# DATABASE_SSL_CA_B64=

# Docker Compose Postgres image (must match DATABASE_URL)
DATABASE_USER=wordmemo
DATABASE_PASSWORD=wordmemo
DATABASE_NAME=wordmemo
DATABASE_PORT=5432

# JWT — use long random secrets in production (different for access/refresh)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Swagger Basic Auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me-swagger-password
